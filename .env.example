# WebVM configuration. Copy this file to .env and adjust as needed.

# Host ports.
WEBVM_HTTP_PORT=8080
WEBVM_TERMINAL_PORT=7681

# Bind address for the published ports. Keep 127.0.0.1 for local-only access.
# Use 0.0.0.0 to expose the terminal to your LAN (set a password first!).
WEBVM_BIND_ADDR=127.0.0.1

# Optional HTTP basic auth for the terminal and API. When empty, the terminal
# is unauthenticated. This is a real root shell inside the container.
WEBVM_USER=admin
WEBVM_PASSWORD=

# Maximum concurrent terminal sessions.
WEBVM_MAX_SESSIONS=8

# Login shell used by the terminal.
WEBVM_SHELL=/bin/bash

# Container name, hostname and timezone.
WEBVM_CONTAINER_NAME=webvm
WEBVM_HOSTNAME=webvm
TZ=UTC
